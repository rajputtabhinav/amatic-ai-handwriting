# DEVELOPMENT CONFIGURATION - Use development keys for local testing

# Clerk Authentication - Get your keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Note: AFTER_SIGN_IN_URL and AFTER_SIGN_UP_URL are deprecated
# Use fallbackRedirectUrl or forceRedirectUrl props directly in components instead

# Production Domain Configuration (for reference)
# NEXT_PUBLIC_CLERK_FRONTEND_API_URL=https://clerk.amatic.ai
# NEXT_PUBLIC_CLERK_JWKS_URL=https://clerk.amatic.ai/.well-known/jwks.json

# Supabase Database
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Razorpay Payments
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# AI APIs - Official Provider Keys
# Anthropic Claude API for Master AI, text generation, planning, SVG code generation
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API for image generation
GOOGLE_AI_API_KEY=your_google_gemini_api_key_here
NEXT_PUBLIC_GOOGLE_AI_API_KEY=your_google_gemini_api_key_here
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here

# ElevenLabs API for premium voice synthesis
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OpenRouter API (Optional - for DeepSeek R1 and alternative models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI API (Optional - for DALL-E or Whisper if needed)
OPENAI_API_KEY=your_openai_api_key_here

# Rate Limiting (Upstash Redis) - Optional, falls back to in-memory if not provided
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000